# Database (Supabase - free)
DATABASE_URL="postgresql://user:password@db.supabase.co:5432/eldera"

# Redis (Upstash - free)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Cloudinary (file storage - free)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Novu (notifications - free)
NOVU_API_KEY="your-novu-api-key"

# Razorpay (test mode - free)
RAZORPAY_KEY_ID="your-test-key-id"
RAZORPAY_SECRET="your-test-secret"

# Groq (AI - free)
GROQ_API_KEY="your-groq-api-key"

# Daily.co (video calls - free tier)
DAILY_API_KEY="your-daily-api-key"

# Email (Resend - free)
RESEND_API_KEY="your-resend-api-key"

# App
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"